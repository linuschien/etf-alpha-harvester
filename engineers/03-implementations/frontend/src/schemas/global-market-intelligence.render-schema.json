{
  "root": "global-market-intelligence-page",
  "elements": {
    "global-market-intelligence-page": {
      "type": "Container:page",
      "props": {
        "id": "global-market-intelligence-page"
      },
      "children": [
        "page-header-section",
        "main-tabs-container",
        "watermark-detail-modal",
        "pairwise-matrix-modal",
        "asset-detail-drawer"
      ]
    },
    "page-header-section": {
      "type": "div",
      "props": {
        "id": "page-header-section"
      },
      "children": [
        "header-title-stack"
      ]
    },
    "header-title-stack": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md",
        "align": "center",
        "justify": "between",
        "className": null
      },
      "children": [
        "header-title-group",
        "data-freshness-trigger"
      ]
    },
    "header-title-group": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm",
        "align": "start",
        "justify": "start",
        "className": null
      },
      "children": [
        "page-title-heading",
        "page-subtitle-text"
      ]
    },
    "page-title-heading": {
      "type": "Heading",
      "props": {
        "text": "台股 ETF 量化收割戰情室 (ETF Alpha Harvester)",
        "level": "h1"
      },
      "children": []
    },
    "page-subtitle-text": {
      "type": "Text",
      "props": {
        "text": "台股 ETF 量化篩選 · 波動收割 · 景氣動態配置",
        "variant": "muted"
      },
      "children": []
    },
    "data-freshness-trigger": {
      "type": "Button",
      "props": {
        "label": "資料同步狀態",
        "variant": "secondary",
        "disabled": null
      },
      "children": [],
      "on": {
        "press": [
          {
            "action": "openModal",
            "params": {
              "id": "watermark-detail-modal"
            }
          }
        ]
      }
    },
    "main-tabs-container": {
      "type": "Card",
      "props": {
        "title": null,
        "description": null,
        "maxWidth": null,
        "centered": null,
        "className": null
      },
      "children": [
        "tabs-nav-stack",
        "macro-sentiment-section",
        "qualified-leaderboard-section",
        "dca-calendar-section"
      ]
    },
    "tabs-nav-stack": {
      "type": "Tabs",
      "props": {
        "tabs": [
          {
            "label": "全球指數雷達",
            "value": "macro-sentiment-section"
          },
          {
            "label": "ETF排行榜",
            "value": "qualified-leaderboard-section"
          },
          {
            "label": "ETF定期定額排行榜與除權息月曆",
            "value": "dca-calendar-section"
          }
        ],
        "defaultValue": "macro-sentiment-section",
        "value": {
          "$bindState": "/activeTab"
        }
      },
      "children": []
    },
    "macro-sentiment-section": {
      "type": "div",
      "props": {
        "id": "macro-sentiment-section",
        "className": "space-y-6"
      },
      "children": [
        "macro-subtabs-nav-stack",
        "macro-subtab-benchmark",
        "macro-subtab-panic",
        "macro-subtab-yield"
      ]
    },
    "macro-subtabs-nav-stack": {
      "type": "Tabs",
      "props": {
        "tabs": [
          {
            "label": "全球指數行情",
            "value": "macro-subtab-benchmark"
          },
          {
            "label": "情緒指標",
            "value": "macro-subtab-panic"
          },
          {
            "label": "宏觀指引與債券殖利率",
            "value": "macro-subtab-yield"
          }
        ],
        "defaultValue": "macro-subtab-benchmark",
        "value": {
          "$bindState": "/activeSubTab"
        }
      },
      "children": []
    },
    "macro-subtab-benchmark": {
      "type": "div",
      "props": {
        "id": "macro-subtab-benchmark",
        "className": "space-y-6"
      },
      "children": [
        "benchmark-quotes-heading",
        "benchmark-quotes-grid",
        "drawdown-radar-container"
      ]
    },
    "macro-subtab-panic": {
      "type": "div",
      "props": {
        "id": "macro-subtab-panic",
        "className": "space-y-6"
      },
      "children": [
        "panic-sentiment-container"
      ]
    },
    "macro-subtab-yield": {
      "type": "div",
      "props": {
        "id": "macro-subtab-yield",
        "className": "space-y-6"
      },
      "children": [
        "macro-yield-container"
      ]
    },
    "benchmark-quotes-heading": {
      "type": "Heading",
      "props": {
        "text": "5 大指數近一日行情",
        "level": "h2"
      },
      "children": []
    },
    "benchmark-quotes-grid": {
      "type": "Grid",
      "props": {
        "columns": 5,
        "gap": "md",
        "className": null
      },
      "children": [
        "metric-twii",
        "metric-gspc",
        "metric-ndx",
        "metric-sox",
        "metric-n225"
      ]
    },
    "metric-twii": {
      "type": "MetricCard",
      "props": {
        "id": "metric-twii",
        "label": "^TWII 台股加權指數 (預設基準)",
        "value": {
          "$bindState": "/metrics/metric-twii"
        },
        "data_ref": "listMarketDailyQuotes"
      },
      "children": []
    },
    "metric-gspc": {
      "type": "MetricCard",
      "props": {
        "id": "metric-gspc",
        "label": "^GSPC 標普500指數",
        "value": {
          "$bindState": "/metrics/metric-gspc"
        },
        "data_ref": "listMarketDailyQuotes"
      },
      "children": []
    },
    "metric-ndx": {
      "type": "MetricCard",
      "props": {
        "id": "metric-ndx",
        "label": "^NDX 那斯達克100指數",
        "value": {
          "$bindState": "/metrics/metric-ndx"
        },
        "data_ref": "listMarketDailyQuotes"
      },
      "children": []
    },
    "metric-sox": {
      "type": "MetricCard",
      "props": {
        "id": "metric-sox",
        "label": "^SOX 費城半導體指數",
        "value": {
          "$bindState": "/metrics/metric-sox"
        },
        "data_ref": "listMarketDailyQuotes"
      },
      "children": []
    },
    "metric-n225": {
      "type": "MetricCard",
      "props": {
        "id": "metric-n225",
        "label": "^N225 日經225指數",
        "value": {
          "$bindState": "/metrics/metric-n225"
        },
        "data_ref": "listMarketDailyQuotes"
      },
      "children": []
    },
    "panic-sentiment-container": {
      "type": "div",
      "props": {
        "id": "panic-sentiment-container",
        "className": "space-y-4"
      },
      "children": [
        "panic-sentiment-heading",
        "panic-sentiment-2x2-grid"
      ]
    },
    "panic-sentiment-heading": {
      "type": "Heading",
      "props": {
        "text": "4 大情緒指數",
        "level": "h3"
      },
      "children": []
    },
    "panic-sentiment-2x2-grid": {
      "type": "Grid",
      "props": {
        "columns": 2,
        "gap": "md",
        "className": "grid-cols-1 md:grid-cols-2"
      },
      "children": [
        "chart-vix-spark",
        "chart-vxn-spark",
        "chart-fear-greed-spark",
        "chart-move-spark"
      ]
    },
    "chart-vix-spark": {
      "type": "Chart",
      "props": {
        "id": "chart-vix-spark",
        "label": "^VIX 波動率指數 (常態通道: 15 ~ 30)",
        "data_ref": "getQuoteTimeSeries"
      },
      "children": []
    },
    "chart-vxn-spark": {
      "type": "Chart",
      "props": {
        "id": "chart-vxn-spark",
        "label": "^VXN 那指波動率指數 (常態通道: 15 ~ 30)",
        "data_ref": "getQuoteTimeSeries"
      },
      "children": []
    },
    "chart-fear-greed-spark": {
      "type": "Chart",
      "props": {
        "id": "chart-fear-greed-spark",
        "label": "FEAR_GREED 恐懼貪婪指數 (常態通道: 25 ~ 75)",
        "data_ref": "getQuoteTimeSeries"
      },
      "children": []
    },
    "chart-move-spark": {
      "type": "Chart",
      "props": {
        "id": "chart-move-spark",
        "label": "^MOVE 美債波動率指數 (常態通道: 60 ~ 120)",
        "data_ref": "getQuoteTimeSeries"
      },
      "children": []
    },
    "macro-yield-container": {
      "type": "div",
      "props": {
        "id": "macro-yield-container",
        "className": "space-y-6"
      },
      "children": [
        "macro-regime-banner",
        "macro-yield-heading",
        "macro-yield-grid",
        "macro-yield-toolbar-stack",
        "macro-yield-chart"
      ]
    },
    "macro-regime-banner": {
      "type": "MacroRegimeBanner",
      "props": {
        "id": "macro-regime-banner",
        "data_ref": "getMacroRegime"
      },
      "children": []
    },
    "macro-yield-heading": {
      "type": "Heading",
      "props": {
        "text": "債券殖利率",
        "level": "h3"
      },
      "children": []
    },
    "macro-yield-grid": {
      "type": "Grid",
      "props": {
        "columns": 4,
        "gap": "md",
        "className": "grid-cols-2 md:grid-cols-4"
      },
      "children": [
        "metric-dgs10",
        "metric-dgs20",
        "metric-t10y2y",
        "metric-corp-yield"
      ]
    },
    "metric-dgs10": {
      "type": "MetricCard",
      "props": {
        "id": "metric-dgs10",
        "label": "10Y 美國公債殖利率 (DGS10)",
        "value": {
          "$bindState": "/metrics/metric-dgs10"
        },
        "data_ref": "getLatestMacroYieldSnapshot"
      },
      "children": []
    },
    "metric-dgs20": {
      "type": "MetricCard",
      "props": {
        "id": "metric-dgs20",
        "label": "20Y 美國公債殖利率 (DGS20)",
        "value": {
          "$bindState": "/metrics/metric-dgs20"
        },
        "data_ref": "getLatestMacroYieldSnapshot"
      },
      "children": []
    },
    "metric-t10y2y": {
      "type": "MetricCard",
      "props": {
        "id": "metric-t10y2y",
        "label": "10Y-2Y 殖利率利差 (T10Y2Y)",
        "value": {
          "$bindState": "/metrics/metric-t10y2y"
        },
        "data_ref": "getLatestMacroYieldSnapshot"
      },
      "children": []
    },
    "metric-corp-yield": {
      "type": "MetricCard",
      "props": {
        "id": "metric-corp-yield",
        "label": "ICE BofA 企業債殖利率 (BAMLC0A0CMEY)",
        "value": {
          "$bindState": "/metrics/metric-corp-yield"
        },
        "data_ref": "getLatestMacroYieldSnapshot"
      },
      "children": []
    },
    "metric-macro-regime": {
      "type": "MetricCard",
      "props": {
        "id": "metric-macro-regime",
        "label": "宏觀景氣燈號 (Macro Regime)",
        "value": {
          "$bindState": "/metrics/metric-macro-regime"
        },
        "data_ref": "getMacroRegime"
      },
      "children": []
    },
    "macro-yield-toolbar-stack": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md",
        "align": "center",
        "justify": null,
        "className": null
      },
      "children": [
        "macro-yield-window-selector"
      ]
    },
    "macro-yield-window-selector": {
      "type": "Radio",
      "props": {
        "id": "macro-yield-window-selector",
        "label": "時間視窗切換 (1M / 3M / 6M (預設) / 1Y)",
        "name": "macro-yield-window-selector",
        "defaultValue": "6M",
        "options": [
          "1M",
          "3M",
          "6M",
          "1Y"
        ],
        "value": {
          "$bindState": "/filters/macro-yield-window-selector"
        },
        "checks": null,
        "validateOn": null
      },
      "children": []
    },
    "macro-yield-chart": {
      "type": "Chart",
      "props": {
        "id": "macro-yield-chart",
        "label": "宏觀利率與利差整合走勢圖 (含 5.0% 蓄水線 / 3.5% 收割線 / 0.0% 倒掛線)",
        "data_ref": "getLatestMacroYieldSnapshot"
      },
      "children": []
    },
    "drawdown-radar-container": {
      "type": "Card",
      "props": {
        "title": null,
        "description": null,
        "maxWidth": null,
        "centered": null,
        "className": null
      },
      "children": [
        "drawdown-heading",
        "drawdown-toolbar-stack",
        "drawdown-radar-chart"
      ]
    },
    "drawdown-heading": {
      "type": "Heading",
      "props": {
        "text": "基準指數走勢與黃金分割回撤監控",
        "level": "h3"
      },
      "children": []
    },
    "drawdown-toolbar-stack": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "lg",
        "align": "center",
        "justify": null,
        "className": "w-full flex-wrap items-center gap-6"
      },
      "children": [
        "drawdown-window-selector",
        "drawdown-switches-stack"
      ]
    },
    "drawdown-switches-stack": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "lg",
        "align": "center",
        "justify": null,
        "className": "flex-wrap items-center gap-6"
      },
      "children": [
        "toggle-ma-switch",
        "toggle-bb-switch",
        "toggle-fib-switch"
      ]
    },
    "drawdown-window-selector": {
      "type": "Radio",
      "props": {
        "label": "時間視窗",
        "name": "drawdown-window-selector",
        "options": [
          "1M",
          "3M",
          "6M",
          "1Y"
        ],
        "value": {
          "$bindState": "/filters/drawdown-window-selector"
        },
        "checks": null,
        "validateOn": null
      },
      "children": []
    },
    "toggle-ma-switch": {
      "type": "Switch",
      "props": {
        "label": "均線",
        "name": "toggle-ma-switch",
        "checked": {
          "$bindState": "/filters/toggle-ma-switch"
        },
        "checks": null,
        "validateOn": null
      },
      "children": []
    },
    "toggle-bb-switch": {
      "type": "Switch",
      "props": {
        "label": "布林通道",
        "name": "toggle-bb-switch",
        "checked": {
          "$bindState": "/filters/toggle-bb-switch"
        },
        "checks": null,
        "validateOn": null
      },
      "children": []
    },
    "toggle-fib-switch": {
      "type": "Switch",
      "props": {
        "label": "黃金分割警戒線",
        "name": "toggle-fib-switch",
        "checked": {
          "$bindState": "/filters/toggle-fib-switch"
        },
        "checks": null,
        "validateOn": null
      },
      "children": []
    },
    "drawdown-radar-chart": {
      "type": "Chart",
      "props": {
        "id": "drawdown-radar-chart",
        "label": "52 週高點回撤走勢圖",
        "data_ref": "getQuoteTimeSeries"
      },
      "children": []
    },
    "qualified-leaderboard-section": {
      "type": "div",
      "props": {
        "id": "qualified-leaderboard-section",
        "className": "space-y-6"
      },
      "children": [
        "asset-class-selector",
        "leaderboard-heading",
        "orthogonal-control-bar",
        "qualified-leaderboard-table",
        "clustering-leaderboard-table"
      ]
    },
    "leaderboard-heading": {
      "type": "Heading",
      "props": {
        "text": "ETF投資清單篩選",
        "level": "h2"
      },
      "children": []
    },
    "orthogonal-control-bar": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md",
        "align": "center",
        "justify": "between",
        "className": "w-full flex flex-wrap items-center justify-between gap-4 py-2 border-b border-border/50"
      },
      "children": [
        "leaderboard-month-stepper",
        "perspective-mode-selector",
        "open-pairwise-matrix-btn"
      ]
    },
    "leaderboard-month-stepper": {
      "type": "MonthStepper",
      "props": {
        "id": "leaderboard-month-stepper",
        "label": "評估月份",
        "value": {
          "$bindState": "/filters/leaderboard-evaluation-date"
        }
      },
      "children": []
    },
    "asset-class-selector": {
      "type": "Tabs",
      "props": {
        "id": "asset-class-selector",
        "tabs": [
          {
            "label": "核心大盤 (Core)",
            "value": "CORE"
          },
          {
            "label": "動能衛星 (Satellite)",
            "value": "SATELLITE"
          },
          {
            "label": "防禦債券 (Defensive)",
            "value": "DEFENSIVE"
          }
        ],
        "defaultValue": "CORE",
        "value": {
          "$bindState": "/filters/asset-class-selector"
        }
      },
      "children": []
    },
    "perspective-mode-selector": {
      "type": "Radio",
      "props": {
        "label": "決策視角模式",
        "name": "perspective-mode-selector",
        "options": [
          "⚡ 夏農幾何收割",
          "🧩 分群去冗餘族群"
        ],
        "value": {
          "$bindState": "/filters/perspective-mode-selector"
        },
        "checks": null,
        "validateOn": null
      },
      "children": []
    },
    "open-pairwise-matrix-btn": {
      "type": "Button",
      "props": {
        "label": "檢視相關性矩陣",
        "variant": "secondary",
        "disabled": null
      },
      "children": [],
      "on": {
        "press": [
          {
            "action": "openModal",
            "params": {
              "id": "pairwise-matrix-modal"
            }
          }
        ]
      }
    },
    "qualified-leaderboard-table": {
      "type": "DataTable",
      "props": {
        "id": "qualified-leaderboard-table",
        "label": "夏農模式正交去共線天梯表 (Shannon Orthogonal Table)",
        "columns": [
          {
            "field": "classRank",
            "label": "原始排名",
            "sortable": true,
            "default_sort": "asc"
          },
          {
            "field": "orthogonalStatus",
            "label": "正交狀態",
            "sortable": true
          },
          {
            "field": "ticker",
            "label": "標的代碼",
            "sortable": false
          },
          {
            "field": "name",
            "label": "標的名稱",
            "sortable": false
          },
          {
            "field": "distributionFrequency",
            "label": "配息週期",
            "sortable": false
          },
          {
            "field": "closePrice",
            "label": "最新市價",
            "sortable": true
          },
          {
            "field": "changePct",
            "label": "單日漲跌(%)",
            "sortable": true
          },
          {
            "field": "return1m",
            "label": "1 個月報酬(%)",
            "sortable": true
          },
          {
            "field": "return3m",
            "label": "3 個月報酬(%)",
            "sortable": true
          },
          {
            "field": "return6m",
            "label": "6 個月報酬(%)",
            "sortable": true
          },
          {
            "field": "return1y",
            "label": "1 年報酬(%)",
            "sortable": true
          },
          {
            "field": "fundSizeTwd",
            "label": "基金規模(AUM)",
            "sortable": true
          },
          {
            "field": "compositeScore",
            "label": "綜合評分",
            "sortable": true
          }
        ],
        "data": {
          "$bindState": "/data/getOrthogonalCandidates"
        }
      },
      "children": []
    },
    "clustering-leaderboard-table": {
      "type": "DataTable",
      "props": {
        "id": "clustering-leaderboard-table",
        "label": "合規標的去冗餘分群階層表 (Hierarchical Expandable Table)",
        "columns": [
          {
            "field": "clusterId",
            "label": "族群編號",
            "sortable": true,
            "default_sort": "asc"
          },
          {
            "field": "isSingleton",
            "label": "賽道角色",
            "sortable": true
          },
          {
            "field": "classRank",
            "label": "原始排名",
            "sortable": true
          },
          {
            "field": "ticker",
            "label": "標的代碼",
            "sortable": false
          },
          {
            "field": "name",
            "label": "標的名稱",
            "sortable": false
          },
          {
            "field": "distributionFrequency",
            "label": "配息週期",
            "sortable": false
          },
          {
            "field": "closePrice",
            "label": "最新市價",
            "sortable": true
          },
          {
            "field": "changePct",
            "label": "單日漲跌(%)",
            "sortable": true
          },
          {
            "field": "return1m",
            "label": "1 個月報酬(%)",
            "sortable": true
          },
          {
            "field": "return3m",
            "label": "3 個月報酬(%)",
            "sortable": true
          },
          {
            "field": "return6m",
            "label": "6 個月報酬(%)",
            "sortable": true
          },
          {
            "field": "return1y",
            "label": "1 年報酬(%)",
            "sortable": true
          },
          {
            "field": "fundSizeTwd",
            "label": "基金規模(AUM)",
            "sortable": true
          },
          {
            "field": "compositeScore",
            "label": "綜合評分",
            "sortable": true
          }
