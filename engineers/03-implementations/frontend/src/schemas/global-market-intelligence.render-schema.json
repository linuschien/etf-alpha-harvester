        "page-header-section",
        "main-tabs-container",
        "watermark-detail-modal",
        "pairwise-matrix-modal",
        "asset-detail-drawer"
      ]
    },
    "page-header-section": {
      "type": "div",
      "props": {
        "id": "page-header-section"
      },
      "children": [
        "header-title-stack"
      ]
    },
    "header-title-stack": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md",
        "align": "center",
        "justify": "between",
        "className": null
      },
      "children": [
        "page-title-heading",
        "page-subtitle-text",
        "data-freshness-trigger"
      ]
    },
    "page-title-heading": {
      "type": "Heading",
      "props": {
        "text": "全球市場情報 (Global Market Intelligence)",
        "level": "h1"
      },
      "children": []
