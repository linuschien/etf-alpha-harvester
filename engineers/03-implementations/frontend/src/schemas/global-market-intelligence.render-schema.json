            "action": "selectSubTab",
            "params": {
              "subTab": "macro-subtab-panic"
            }
          }
        ]
      }
    },
    "subtab-yield-trigger": {
      "type": "Button",
      "props": {
        "id": "subtab-yield-trigger",
        "label": "宏觀利率與殖利率曲線",
        "variant": "outline",
        "disabled": null
