      "children": [],
      "on": {
        "press": [
          {
            "action": "openModal",
            "params": {
              "id": "watermark-detail-modal"
            }
          }
        ]
      }
    },
    "main-tabs-container": {
      "type": "Card",
      "props": {
        "title": null,
        "description": null,
        "maxWidth": null,
        "centered": null,
