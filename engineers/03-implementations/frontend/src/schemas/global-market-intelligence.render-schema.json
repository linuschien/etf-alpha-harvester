        "press": [
          {
            "action": "selectTab",
            "params": {
              "tab": "qualified-leaderboard-section"
            }
          }
        ]
      }
    },
    "tab-dca-trigger": {
      "type": "Button",
      "props": {
        "label": "定期定額散戶人氣榜與除息月曆",
        "variant": "secondary",
        "disabled": null
