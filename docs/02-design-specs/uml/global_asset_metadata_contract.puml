@startuml global_asset_metadata_contract

!pragma layout smetana
skinparam packageStyle rectangle
skinparam defaultFontName Inter

title GlobalAssetMetadata - GraphQL Query & Persistence Contract

package "adapter.in.web.graphql" {
  interface "GlobalAssetMetadataGraphQLResolver" <<GraphQLResolver>> {
    ' --- UI Read Gateway ---
    + listGlobalAssets(filter: GlobalAssetFilterInput): List<GlobalAssetMetadata>
    + getGlobalAssetById(id: UUID): Optional<GlobalAssetMetadata>
    + getGlobalAssetByTicker(ticker: String): Optional<GlobalAssetMetadata>
  }
}

package "adapter.out.persistence" {
  interface "GlobalAssetMetadataRepository" <<Repository>> {
    + save(entity: GlobalAssetMetadata): GlobalAssetMetadata
    + saveAll(entities: List<GlobalAssetMetadata>): List<GlobalAssetMetadata>
    + findById(id: UUID): Optional<GlobalAssetMetadata>
    + findByTicker(ticker: String): Optional<GlobalAssetMetadata>
    + findAll(): List<GlobalAssetMetadata>
    + findByExample(example: Example<GlobalAssetMetadata>): List<GlobalAssetMetadata>
  }
}

note right of GlobalAssetMetadataRepository
  Master Data Catalog.
  Updated via automated MarketDataSyncService pipeline.
  Read exclusively via GraphQL Query Gateway.
end note

' === Dependency Arrows ===
"GlobalAssetMetadataGraphQLResolver" ..> "GlobalAssetMetadataRepository" : queries

@enduml
