@startuml corporate_action_contract

!pragma layout smetana
skinparam packageStyle rectangle
skinparam defaultFontName Inter

title CorporateAction - GraphQL Query & Persistence Contract

package "adapter.in.web.graphql" {
  interface "CorporateActionGraphQLResolver" <<GraphQLResolver>> {
    ' --- UI Read Gateway ---
    + listCorporateActions(filter: CorporateActionFilterInput): List<CorporateAction>
    + getCorporateActionById(id: UUID): Optional<CorporateAction>
    + getEffectiveSplits(ticker: String, effectiveDate: LocalDate): List<CorporateAction>
    + listCorporateActionsByAssetId(assetId: UUID): List<CorporateAction>
  }
}

package "adapter.out.persistence" {
  interface "CorporateActionRepository" <<Repository>> {
    + save(entity: CorporateAction): CorporateAction
    + saveAll(entities: List<CorporateAction>): List<CorporateAction>
    + findById(id: UUID): Optional<CorporateAction>
    + findByTickerAndEffectiveDate(ticker: String, effectiveDate: LocalDate): Optional<CorporateAction>
    + findByAssetId(assetId: UUID): List<CorporateAction>
    + findByExample(example: Example<CorporateAction>): List<CorporateAction>
  }
}

note right of CorporateActionRepository
  Immutable Stock Split & Corporate Action Events.
  Ingested from TWSE via MarketDataSyncService (POST /marketData:sync).
  Read exclusively via GraphQL Query Gateway.
end note

' === Dependency Arrows ===
"CorporateActionGraphQLResolver" ..> "CorporateActionRepository" : queries

@enduml
