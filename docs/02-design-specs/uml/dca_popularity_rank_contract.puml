@startuml dca_popularity_rank_contract

!pragma layout smetana
skinparam packageStyle rectangle
skinparam defaultFontName Inter

title DcaPopularityRank - GraphQL Query & Persistence Contract

package "adapter.in.web.graphql" {
  interface "DcaPopularityRankGraphQLResolver" <<GraphQLResolver>> {
    ' --- UI Read Gateway ---
    + listDcaPopularityRanks(filter: DcaPopularityFilterInput): List<DcaPopularityRank>
    + getDcaPopularityRankById(id: UUID): Optional<DcaPopularityRank>
    + getTop20DcaRanks(year: Integer, month: Integer): List<DcaPopularityRank>
    + listDcaRanksByAssetId(assetId: UUID): List<DcaPopularityRank>
  }
}

package "adapter.out.persistence" {
  interface "DcaPopularityRankRepository" <<Repository>> {
    + save(entity: DcaPopularityRank): DcaPopularityRank
    + saveAll(entities: List<DcaPopularityRank>): List<DcaPopularityRank>
    + findById(id: UUID): Optional<DcaPopularityRank>
    + findByRankingYearAndRankingMonth(year: Integer, month: Integer): List<DcaPopularityRank>
    + findByAssetId(assetId: UUID): List<DcaPopularityRank>
    + findByExample(example: Example<DcaPopularityRank>): List<DcaPopularityRank>
  }
}

note right of DcaPopularityRankRepository
  Immutable Monthly DCA Investor Popularity Rankings.
  Ingested monthly from TWSE via MarketDataSyncService (POST /marketData:sync).
  Read exclusively via GraphQL Query Gateway.
end note

' === Dependency Arrows ===
"DcaPopularityRankGraphQLResolver" ..> "DcaPopularityRankRepository" : queries

@enduml
