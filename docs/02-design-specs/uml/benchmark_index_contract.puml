@startuml benchmark_index_contract

!pragma layout smetana
skinparam packageStyle rectangle
skinparam defaultFontName Inter

title BenchmarkIndex - GraphQL Query & Persistence Contract

package "adapter.in.web.graphql" {
  interface "BenchmarkIndexGraphQLResolver" <<GraphQLResolver>> {
    ' --- UI Read Gateway ---
    + listBenchmarkIndices(): List<BenchmarkIndex>
    + getBenchmarkIndexById(id: UUID): Optional<BenchmarkIndex>
    + getBenchmarkIndexByTicker(ticker: String): Optional<BenchmarkIndex>
  }
}

package "adapter.out.persistence" {
  interface "BenchmarkIndexRepository" <<Repository>> {
    + save(entity: BenchmarkIndex): BenchmarkIndex
    + findById(id: UUID): Optional<BenchmarkIndex>
    + findByTicker(ticker: String): Optional<BenchmarkIndex>
    + findAll(): List<BenchmarkIndex>
    + findByExample(example: Example<BenchmarkIndex>): List<BenchmarkIndex>
  }
}

note right of BenchmarkIndexRepository
  Predefined 9 Global Benchmarks & Sentiment Radar.
  Seeded via Flyway V2 script; read exclusively via GraphQL Query Gateway.
