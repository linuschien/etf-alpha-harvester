@startuml global_asset_score_contract

!pragma layout smetana
skinparam packageStyle rectangle
skinparam defaultFontName Inter

title GlobalAssetScore - GraphQL Query & Persistence Contract

package "adapter.in.web.graphql" {
  interface "GlobalAssetScoreGraphQLResolver" <<GraphQLResolver>> {
    ' --- UI Read Gateway ---
    + listGlobalAssetScores(filter: GlobalAssetScoreFilterInput): List<GlobalAssetScore>
    + getGlobalAssetScoreById(id: UUID): Optional<GlobalAssetScore>
    + getScoresByAssetClass(assetClass: CandidateAssetClass, evaluationDate: LocalDate): List<GlobalAssetScore>
    + getScoreByTicker(ticker: String, evaluationDate: LocalDate): Optional<GlobalAssetScore>
  }
}

package "adapter.out.persistence" {
  interface "GlobalAssetScoreRepository" <<Repository>> {
    + save(entity: GlobalAssetScore): GlobalAssetScore
    + saveAll(entities: List<GlobalAssetScore>): List<GlobalAssetScore>
    + findById(id: UUID): Optional<GlobalAssetScore>
    + findByTickerAndEvaluationDate(ticker: String, evaluationDate: LocalDate): Optional<GlobalAssetScore>
    + findByAssetClassAndEvaluationDate(assetClass: CandidateAssetClass, evaluationDate: LocalDate): List<GlobalAssetScore>
    + findByExample(example: Example<GlobalAssetScore>): List<GlobalAssetScore>
  }
}

note right of GlobalAssetScoreRepository
  Immutable Candidate Evaluation Snapshots.
  Calculated via GlobalAssetScoreEvaluationService (POST /globalAssetScores:evaluate).
  Read exclusively via GraphQL Query Gateway.
end note

' === Dependency Arrows ===
"GlobalAssetScoreGraphQLResolver" ..> "GlobalAssetScoreRepository" : queries

@enduml
